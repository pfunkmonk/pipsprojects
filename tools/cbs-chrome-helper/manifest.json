{
  "manifest_version": 3,
  "name": "Thunder Bowl Data Helper",
  "version": "0.10.7",
  "description": "User-triggered, read-only CBS league setup and four-source fantasy-football data capture for Pip's tools.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://*.football.cbssports.com/*",
    "https://www.footballguys.com/*",
    "https://www.fantasypros.com/*",
    "https://www.pff.com/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pipsprojects.com/thunder-bowl/*",
        "https://pipsprojects.com/draft-day/*",
        "http://localhost:8888/thunder-bowl/*",
        "http://localhost:8888/draft-day/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.football.cbssports.com/*"],
      "js": ["cbs-page-reader.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Thunder Bowl Data Helper"
  }
}
