{
  "manifest_version": 3,
  "name": "Thunder Bowl Data Helper",
  "version": "0.7.9",
  "description": "User-triggered, read-only CBS, Footballguys, FantasyPros, and PFF weekly data capture for Thunder Bowl.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://berrymvp.football.cbssports.com/*",
    "https://www.footballguys.com/*",
    "https://www.fantasypros.com/*",
    "https://www.pff.com/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pipsprojects.com/thunder-bowl/*",
        "http://localhost:8888/thunder-bowl/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Thunder Bowl Data Helper"
  }
}
